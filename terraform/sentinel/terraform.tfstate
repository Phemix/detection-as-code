              }
            ],
            "alert_rule_template_guid": "",
            "alert_rule_template_version": "",
            "custom_details": null,
            "description": "Detects memory dumping of LSASS process using ProcDump or comsvcs.dll MiniDump, common techniques for credential theft.",
            "display_name": "LSASS Memory Dump via ProcDump or comsvcs.dll (DET-00001)",
            "enabled": true,
            "entity_mapping": [],
            "event_grouping": [],
            "id": "/subscriptions/d72ebff3-a191-455c-a656-30eaf62dacb2/resourceGroups/rg-detection-as-code/providers/Microsoft.OperationalInsights/workspaces/law-detection-as-code/providers/Microsoft.SecurityInsights/alertRules/DET-00001-LSASS-Memory-Dump-via-ProcDump",
            "incident": [
              {
                "create_incident_enabled": true,
                "grouping": [
                  {
                    "by_alert_details": null,
                    "by_custom_details": null,
                    "by_entities": [
                      "Host"
                    ],
                    "enabled": true,
                    "entity_matching_method": "Selected",
                    "lookback_duration": "PT1H",
                    "reopen_closed_incidents": false
                  }
                ]
              }
            ],
            "incident_configuration": [
              {
                "create_incident": true,
                "grouping": [
                  {
                    "enabled": true,
                    "entity_matching_method": "Selected",
                    "group_by_alert_details": [],
                    "group_by_custom_details": [],
                    "group_by_entities": [
                      "Host"
                    ],
                    "lookback_duration": "PT1H",
                    "reopen_closed_incidents": false
                  }
                ]
              }
            ],
            "log_analytics_workspace_id": "/subscriptions/d72ebff3-a191-455c-a656-30eaf62dacb2/resourceGroups/rg-detection-as-code/providers/Microsoft.OperationalInsights/workspaces/law-detection-as-code",
            "name": "DET-00001-LSASS-Memory-Dump-via-ProcDump",
            "query": "// ────────────────────────────────────────────────\n// Rule:     LSASS Memory Dump via ProcDump or comsvcs.dll\n// ID:       DET-00001\n// Type:     detection\n// Severity: critical (Sentinel: High)\n// MITRE:    T1003.001\n// Author:   Detection Engineering Team\n// Created:  2024-01-15  Modified: 2024-01-15\n// Schedule: */5 * * * *  |  earliest: -10m  latest: now\n// ────────────────────────────────────────────────\n// Target:   Microsoft Sentinel (DeviceProcessEvents / MDE)\n// Deploy:   Sentinel Analytics Rules → Scheduled Query\n// ────────────────────────────────────────────────\n\nDeviceProcessEvents\n| where FileName in~ (\"procdump.exe\", \"procdump64.exe\")\n| where ProcessCommandLine contains \"lsass\"\n| where ProcessCommandLine contains \"-ma\"\n| where not (AccountName contains \"SYSTEM\" and InitiatingProcessFileName =~ \"mmc.exe\")\n| project TimeGenerated, DeviceName, AccountName, FolderPath,\n          ProcessCommandLine, InitiatingProcessFolderPath, InitiatingProcessCommandLine\n| extend\n    RuleName = \"LSASS Memory Dump via ProcDump or comsvcs.dll\",\n    RuleId = \"DET-00001\",\n    Severity = \"High\",\n    MitreTechnique = \"T1003.001\"\n| project\n    TimeGenerated,\n    RuleName,\n    RuleId,\n    Severity,\n    MitreTechnique,\n    DeviceName,\n    AccountName,\n    ProcessCommandLine,\n    FolderPath,\n    InitiatingProcessCommandLine,\n    InitiatingProcessFolderPath\n",
            "query_frequency": "PT5M",
            "query_period": "PT10M",
            "sentinel_entity_mapping": [],
            "severity": "High",
            "suppression_duration": "PT5H",
            "suppression_enabled": false,
            "tactics": [
              "CredentialAccess"
            ],
            "techniques": [
              "T1003"
            ],
            "timeouts": null,
            "trigger_operator": "GreaterThan",
            "trigger_threshold": 0
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "eyJlMmJmYjczMC1lY2FhLTExZTYtOGY4OC0zNDM2M2JjN2M0YzAiOnsiY3JlYXRlIjoxODAwMDAwMDAwMDAwLCJkZWxldGUiOjE4MDAwMDAwMDAwMDAsInJlYWQiOjMwMDAwMDAwMDAwMCwidXBkYXRlIjoxODAwMDAwMDAwMDAwfX0=",
