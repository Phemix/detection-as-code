      "name": "lsass_memory_dump_procdump",
      "provider": "provider[\"registry.terraform.io/hashicorp/azurerm\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "alert_details_override": [
              {
                "description_format": "LSASS memory dump detected on {{DeviceName}} by {{AccountName}}",
                "display_name_format": "",
                "dynamic_property": [],
