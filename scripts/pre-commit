#!/bin/bash
# pre-commit hook — validates staged detection rules before every commit
# Install: make install-hooks
# Manual install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

# Activate venv if present
if [ -f ".venv/bin/activate" ]; then
  source .venv/bin/activate
fi

# Get staged rule files only
STAGED=$(git diff --cached --name-only -- 'rules/**/*.yml' 'rules/*.yml' 2>/dev/null | grep '\.yml$')

# Nothing staged — skip
if [ -z "$STAGED" ]; then
  exit 0
fi

echo ""
echo "  Pre-commit: validating staged rules..."
echo ""

FAILED=0

for file in $STAGED; do
  if [ -f "$file" ]; then
    python3 scripts/validate.py --file "$file"
    if [ $? -ne 0 ]; then
      FAILED=1
    fi
  fi
done

if [ $FAILED -ne 0 ]; then
  echo ""
  echo "  Commit blocked — fix validation errors above and try again."
  echo "  To skip validation (not recommended): git commit --no-verify"
  echo ""
  exit 1
fi

echo ""
echo "  All staged rules passed validation."
echo ""
exit 0
